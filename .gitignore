# ===== 环境变量与凭据 =====
.env
*.env
!.env.example
!*.env.example

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== Node =====
node_modules/

# ===== ESP-IDF / ESP32 固件 =====
firmware/**/build/
firmware/**/managed_components/
# dependencies.lock files are tracked for reproducible component versions
firmware/**/sdkconfig
firmware/**/sdkconfig.old
tools/firmware/*.bin

# ===== Docker 本地数据卷 =====
server/data/

# ===== 日志 =====
*.log

# ===== KiCad / EDA =====
hardware/**/*-backups/
hardware/**/*.kicad_pcb-bak
hardware/**/fp-info-cache

# ===== IDE / 系统 =====
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local firmware secrets
firmware/**/main/wifi_secrets.h

# One-off debugging backups (Git tags/commits are the version checkpoint)
*.bak
firmware/gateway/main/main_backup.c
firmware/gateway/main/main_v2.c

# Generated Mosquitto credentials (create locally from server/.env)
server/mosquitto/config/password.txt
