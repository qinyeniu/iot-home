# 复制为 server/.env 后修改；server/.env 已被 .gitignore 忽略，严禁提交到仓库。

# ----- MQTT（Mosquitto）-----
MQTT_HOST=mosquitto
MQTT_PORT=1883

# 推荐：后端与网关使用独立账号。配置这四项后会自动启用最小权限模式。
MQTT_BACKEND_USER=iot_backend
MQTT_BACKEND_PASSWORD=改成后端强密码
MQTT_GATEWAY_USER=iot_gateway_gw001
MQTT_GATEWAY_PASSWORD=改成网关强密码
MQTT_GATEWAY_ID=gw-001

# 迁移期间可临时设 true，让新旧账号共存；网关升级验证完成后必须恢复 false。
MQTT_ENABLE_LEGACY_ACCOUNT=false

# 兼容旧部署/回退：若上面四个账号留空，则使用这个共享账号；完成迁移后可删除。
MQTT_USER=iot_user
MQTT_PASSWORD=改成强密码
MQTT_TOPIC_PREFIX=iot-home
# 迁移期间也必须保持 false；使用 MQTT_ENABLE_LEGACY_ACCOUNT 完成新旧账号共存
MQTT_ALLOW_ANONYMOUS=false

# ----- MySQL -----
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=改成root强密码
MYSQL_DATABASE=iot_home
MYSQL_USER=iot_home
MYSQL_PASSWORD=改成数据库强密码

# ----- FastAPI -----
API_PORT=8000

# ----- Grafana -----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=改成Grafana强密码

# ----- 设备离线判断 -----
DEVICE_OFFLINE_TIMEOUT_SECONDS=180
DEVICE_STATUS_CHECK_INTERVAL_SECONDS=20
