# ===== iot-home 服务端环境变量 =====
# 使用方法：复制本文件为 server/.env 后填写真实值。
# server/.env 已被 .gitignore 忽略，严禁提交到仓库。

# ----- MQTT（Mosquitto）-----
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=iot_user
MQTT_PASSWORD=改成强密码
MQTT_TOPIC_PREFIX=iot-home
# 迁移 MQTT 认证时可临时设 true；最终必须为 false
MQTT_ALLOW_ANONYMOUS=false

# ----- MySQL -----
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=iot_home
MYSQL_USER=iot_home
MYSQL_PASSWORD=改成强密码
MYSQL_ROOT_PASSWORD=改成强密码

# ----- FastAPI -----
API_PORT=8000

# ----- Grafana -----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=改成强密码

# ----- 设备超时离线（可选）-----
DEVICE_OFFLINE_TIMEOUT_SECONDS=180
DEVICE_STATUS_CHECK_INTERVAL_SECONDS=20
